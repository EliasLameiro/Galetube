MYSQL_DATABASE=galetube
MYSQL_USER=galetube
MYSQL_PASSWORD=cambiar_me
MYSQL_ROOT_PASSWORD=cambiar_me
MYSQL_PORT=3307

# Base64 de 32 bytes aleatorios
JWT_SECRET=<genera algo aleatorio>

# Credenciales del almacenamiento S3 local (SeaweedFS). Secreto: openssl rand -hex 16
S3_ACCESS_KEY=galetube
S3_SECRET_KEY=<genera algo aleatorio>
S3_BUCKET=galetube-videos
